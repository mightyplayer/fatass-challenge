# База данных PostgreSQL
DATABASE_URL=postgresql://slim:REPLACE_ME@localhost:5432/slim
POSTGRES_PASSWORD=

# Публичный адрес приложения (без слэша в конце). Должен совпадать с Allowed URL в BotFather.
APP_URL=https://example.com

# Длинная случайная строка для подписи сессий: openssl rand -base64 48
SESSION_SECRET=

# Telegram Login (OIDC): @BotFather → бот → Login Widget → Client ID / Client Secret.
# Redirect URI для регистрации в BotFather: ${APP_URL}/api/auth/telegram/callback
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# Соревнование
COMPETITION_TITLE=Жиробас челлендж
# Старт (стартовый вес и талия), число еженедельных отчётов и финал (раскрытие ставок)
COMPETITION_START=2026-10-12
COMPETITION_WEEKS=11
COMPETITION_FINAL=2026-12-31

# Супер-админы: Telegram id или @username через запятую.
# Супер-админ назначает админов в /admin; админы вносят результаты участников.
SUPERADMIN_TELEGRAM=

# Хранилище картинок. Если S3_BUCKET не задан, файлы пишутся в UPLOAD_DIR.
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Вход без Telegram для локальной разработки (в production игнорируется)
DEV_LOGIN=false
